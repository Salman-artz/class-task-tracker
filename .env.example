# Salin file ini menjadi .env lalu sesuaikan. JANGAN commit file .env.
PORT=3000
DATABASE_URL=postgres://tasks:ganti_password_ini@localhost:5432/class_tasks
# Untuk test (database terpisah agar data asli tidak terhapus)
TEST_DATABASE_URL=postgres://tasks:ganti_password_ini@localhost:5432/class_tasks_test
# Ganti dengan string acak panjang, misal: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
JWT_EXPIRES_IN=2h
# Kode undangan yang dibutuhkan untuk mendaftar sebagai guru
TEACHER_INVITE_CODE=ganti-kode-undangan-guru
# Origin frontend yang diizinkan jika frontend dipisah (kosongkan jika satu origin)
CORS_ORIGIN=
